{
  "cleanUrls": true,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/microbiologia",
      "destination": "/microbiologia/index.html"
    },
    {
      "source": "/microbiologia/(.*)",
      "destination": "/microbiologia/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}